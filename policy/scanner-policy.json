{
  "version": 3,
  "limits": {
    "compressedBytes": 52428800,
    "expandedBytes": 209715200,
    "entryBytes": 52428800,
    "entries": 8192,
    "compressionRatio": 200
  },
  "allowedExtensions": [".lua", ".json", ".ini", ".xml", ".txt", ".md", ".png", ".jpg", ".jpeg", ".dds", ".wav", ".ps1", ".sh", ".yml", ".yaml", ".gitmodules", ".gitattributes", ".gitignore", ""],
  "privilegedPackageIds": ["vanahub"],
  "privilegedPackageSources": {
    "vanahub": "https://github.com/Hildaware/vanahub"
  },
  "allowedModules": ["common", "chat", "imgui", "settings", "json", "ffxi.enums", "ffxi.recast", "ffxi.targets", "ffxi.vanatime", "ffxi.weather", "ffi", "os", "io", "package"],
  "capabilityWarnings": {
    "packet-read": "Reads incoming game network packets.",
    "settings-write": "Writes persistent addon settings.",
    "bundled-file-read": "Reads files bundled with the addon.",
    "native-interop": "Calls native operating system APIs.",
    "process-execution": "Executes background shell commands.",
    "file-access": "Reads or writes files directly.",
    "dynamic-code": "Dynamically loads and executes Lua code at runtime.",
    "memory-write": "Directly modifies game memory.",
    "network": "Accesses the internet or local network."
  },
  "dangerousCapabilities": [
    "native-interop", "network", "file-access", "process-execution",
    "dynamic-code", "unapproved-module", "memory-write", "packet-injection",
    "command-injection", "registry-write", "obfuscation", "elevated"
  ],
  "blockedSymbols": [
    "socket", "ssl.https",
    "InjectPacket", "QueueCommand", "CreateProcess", "ShellExecute", "WinExec",
    "LoadLibrary", "RegSetValue", "URLDownloadToFile"
  ]
}
